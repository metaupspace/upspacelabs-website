# Copy to .env.local and fill in. Only these variables are read by the website.

# Strapi CMS (cms/) — all page content. Without it every page shows its built-in copy.
STRAPI_URL=http://localhost:1337
# Optional read token (the seeded content types are publicly readable).
STRAPI_API_TOKEN=
# Create-only token for contact-form submissions (Strapi: Settings → API Tokens,
# custom, permission "Contact-submission: create").
STRAPI_CONTACT_API_TOKEN=
# Seconds Strapi content is cached in production (development always refetches).
STRAPI_REVALIDATE_SECONDS=300

# Job Portal backend (Job_Portal_Backend) — open roles, role pages and applications on /career.
# Public: the browser calls it too.
NEXT_PUBLIC_JOBS_API_URL=https://your-job-portal.upspacelabs.com
