registry=https://registry.npmjs.org/
# @metaupspace packages live on GitHub Packages. In CI and Docker the token comes from
# NODE_AUTH_TOKEN; locally pnpm falls back to your user-level ~/.npmrc
# (//npm.pkg.github.com/:_authToken=<token with read:packages>).
@metaupspace:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
