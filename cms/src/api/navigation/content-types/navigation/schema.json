{
  "kind": "singleType",
  "collectionName": "navigations",
  "info": {
    "singularName": "navigation",
    "pluralName": "navigations",
    "displayName": "Navigation",
    "description": "Site-wide navbar and footer content"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "logoDark": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "navLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.nav-link"
    },
    "ctaText": {
      "type": "string",
      "required": true
    },
    "ctaHref": {
      "type": "string",
      "required": true
    },
    "appearanceLabel": {
      "type": "string"
    },
    "footerColumns": {
      "type": "component",
      "repeatable": true,
      "component": "shared.footer-column"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link"
    },
    "copyright": {
      "type": "string",
      "required": true
    },
    "footerCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.footer-cta"
    },
    "footerLogo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
