{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post",
    "description": "A blog post / customer story, shown at /blog/<slug>"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "text",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "excerpt": {
      "type": "text"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "logosLabel": {
      "type": "string"
    },
    "logos": {
      "type": "component",
      "repeatable": true,
      "component": "shared.logo"
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    },
    "body": {
      "type": "dynamiczone",
      "components": ["blog.text-section", "blog.pull-quote", "blog.image"]
    },
    "moreStories": {
      "type": "component",
      "repeatable": false,
      "component": "landing.card-carousel"
    }
  }
}
